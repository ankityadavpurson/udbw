{
  "name": "universal-db-workbench",
  "version": "0.1.0",
  "description": "Cross-platform desktop database workbench for MySQL, PostgreSQL, MongoDB, Supabase and Firebase Firestore",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "dev": "npm run build:ui && electron .",
    "build:ui": "vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "firebase-admin": "^13.5.0",
    "mongodb": "^6.19.0",
    "mysql2": "^3.14.3",
    "pg": "^8.16.3",
    "react": "^19",
    "react-dom": "^19",
    "ssh2": "^1.17.0",
    "xedonium": "^1.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5",
    "autoprefixer": "^10.6.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4",
    "vite": "^7"
  },
  "build": {
    "appId": "dev.universaldb.workbench",
    "productName": "Universal DB Workbench",
    "files": [
      "src/main.js",
      "src/preload.js",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
